{
  "name": "graeper-stationskonfigurator",
  "version": "1.0.0",
  "private": true,
  "description": "3D-Online-Konfigurator für Versorgungsstationen (Kompakt- und begehbare Stationen) – GRÄPER",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:all": "node --disable-warning=ExperimentalWarning server/index.mjs & vite"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/overpass": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
